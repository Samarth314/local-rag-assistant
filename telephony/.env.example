# Copy to telephony/.env (gitignored) and fill in. Nothing here is committed.

# Tailnet address of the host running Asterisk (e.g. the Mac mini or the Orin).
ATARU_SIP_HOST=100.x.y.z

# Softphone SIP password. Long and random; it only ever travels over the tailnet.
ATARU_SIP_PASSWORD=change-me

# DTMF access code the caller must key before ATARU reads anything out.
# Caller ID is trivially spoofed, so this is the real authentication.
ATARU_VOICE_PIN=change-me

# Optional: local speech engines. Leave blank for keypad-only + espeak-ng.
# RAG_STT_URL=http://100.x.y.z:8081/asr
# RAG_TTS_URL=http://100.x.y.z:8080/tts
