# Copy to `.env` (gitignored). Compose loads it automatically.
#
#     cp .env.example .env

# Cloud escalation (--deep). Inert without it; everything else runs locally.
ANTHROPIC_API_KEY=

# Where your documents live. Defaults to the bundled samples.
# DOCS_DIR=/home/samarth/vault

# --- VoIP push: ringing the iPhone with ATARU closed -------------------------
#
# From developer.apple.com -> Certificates, Identifiers & Profiles -> Keys.
# Create a key with "Apple Push Notifications service (APNs)" enabled. The .p8
# downloads exactly once; the 10 characters in its filename are the key id.
#
# The key is a SECRET: anyone holding it can ring the registered phones until
# it is revoked. Keep it outside this checkout and mount it read-only.

# Directory holding the .p8 on the host. Mounted at /keys in the container.
# APNS_KEY_DIR=/home/samarth/.ataru

# Path INSIDE the container -- so /keys/<filename>, not the host path.
# RAG_APNS_KEY_PATH=/keys/AuthKey_22P3W23KJ6.p8

# The 10 characters from the .p8 filename.
# RAG_APNS_KEY_ID=22P3W23KJ6

# Apple team id.
# RAG_APNS_TEAM_ID=J9K575ALMY

# The iOS app's bundle identifier. voip.py appends ".voip" to build the push
# topic, so do not include that suffix here.
# RAG_APNS_BUNDLE_ID=com.samarthshah.ataru.ATARU
