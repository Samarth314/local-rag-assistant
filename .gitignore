# Personal data -- the index contains extracted text of indexed documents.
# Never commit.
data/

.venv/
__pycache__/
*.pyc
.DS_Store

# Secrets -- ANTHROPIC_API_KEY and anything else local-only. Never commit.
.env

# Telephony secrets (SIP password, DTMF access code). Never commit.
telephony/.env

# Per-machine compose settings (GPU runtime, ports, extra mounts). Compose
# loads this automatically and merges it over docker-compose.yml. Editing the
# tracked file for one host's quirks makes every `git pull` conflict; this does
# not. See docker-compose.override.example.yml.
docker-compose.override.yml

# APNs signing keys -- anyone holding one can ring the registered phones.
*.p8
secrets/*
!secrets/README.txt
